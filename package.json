{
  "name": "cartwright",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "4.4.3",
      "typescript": "^6.0.3",
      "lucide-react": "^1.27.0",
      "next": "^16.3.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.6.27",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @cartwright/db --",
    "db:studio": "turbo run db:studio -F @cartwright/db --",
    "db:generate": "turbo run db:generate -F @cartwright/db --",
    "db:migrate": "turbo run db:migrate -F @cartwright/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "seed:posthog": "bun run scripts/seed-posthog.ts",
    "clear:posthog": "bun run scripts/clear-posthog.ts",
    "inspect:posthog": "bun run scripts/inspect-posthog.ts",
    "create:dashboard": "bun run scripts/create-posthog-dashboard.ts",
    "seed:15days": "bun run scripts/seed-15days-simulation.ts",
    "seed:boat-30days": "bun run scripts/seed-boat-30days.ts",
    "preview:boat-30days": "bun run scripts/seed-boat-30days.ts --dry-run",
    "seed:boat-db": "bun run scripts/seed-boat-db.ts",
    "preview:boat-db": "bun run scripts/seed-boat-db.ts --dry-run",
    "preview:15days": "bun run scripts/preview-15days-data.ts",
    "create:15days-dashboard": "bun run scripts/create-15days-dashboard.ts"
  },
  "dependencies": {
    "@cartwright/db": "workspace:*",
    "@cartwright/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
